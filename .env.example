# Nexus Environment Variables
# Copy to .env and fill in values

# Server port (default: 8080)
PORT=8080

# Directory for SQLite database and uploaded files (default: ./data)
DATA_DIR=./data

# JWT signing secret — CHANGE THIS to a long random string in production!
# Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-use-a-long-random-string-here
